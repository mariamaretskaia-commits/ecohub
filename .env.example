# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Public URL where Mini App is hosted (HTTPS required in production)
# On Railway leave empty – detected from RAILWAY_PUBLIC_DOMAIN
WEBAPP_URL=https://your-domain.com

# Server
PORT=3001
NODE_ENV=development

# Secret for signing (use random string in production)
JWT_SECRET=change-me-to-random-secret

# --- Cloud (Render + Supabase), optional for local ---
# DATABASE_URL=postgresql://postgres.xxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Если DATABASE_URL не задан или закомментирован — сервер использует локальный SQLite
# (server/data/eco-grodno.db), демо-данные создаются при первом старте. Прод читает
# свои env-переменные с Render и на этот файл не смотрит.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=item-photos

# Optional Carto basemap (otherwise OpenStreetMap tiles)
# VITE_CARTO_API_KEY=

# --- Trust & Safety (модерация) ---
# TOKEN для админ-очереди модерации (заголовок X-Trust-Token)
TRUST_ADMIN_TOKEN=change-me-trust-token
# Telegram id админов модерации через запятую (получают уведомления о блокировках)
TRUST_ADMIN_IDS=
# OpenAI API key (опционально): AI-модерация текста/картинок. Без него — словарный фильтр
# OPENAI_API_KEY=
# OPENAI_MODERATION_URL=https://api.openai.com/v1/moderations
# OPENAI_VISION_URL=https://api.openai.com/v1/chat/completions
# Пороги trust-уровней (опционально)
# TRUST_BASE=50
# TRUST_LOW_MIN=70
# TRUST_HIGH_MAX=40

# --- AI-модерация: NVIDIA Nemotron 3.5 Content Safety через OpenRouter (бесплатно) ---
# Ключ OpenRouter: нужен аккаунт на openrouter.ai (бесплатные модели стоят 0).
# Цепочка: Nemotron → OpenAI omni-moderation → Zhipu GLM → словарный фильтр.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3.5-content-safety:free
# OPENROUTER_DISABLE_REASONING=1  # отключить reasoning для скорости
# AI_MODERATION_BUDGET_MS=2800    # суммарный лимит ИИ-модерации (публикация не ждёт дольше)
# AI_MODERATION_TIMEOUT_MS=2500   # таймаут одного хоппера
# # Резервная ИИ-модерация OpenAI omni-moderation (опционально):
# OPENAI_API_KEY=
# OPENAI_MODERATION_URL=https://api.openai.com/v1/moderations

# --- Vision (фото-классификация вещей) ---
# Zhipu GLM: бесплатные модели z.ai — GLM-4.7-Flash (текст) и GLM-4.6V-Flash (зрение).
# Без ключа выключено (клиент уходит в офлайн-словарь/ручной выбор)
# ZHIPU_API_KEY=
# ZHIPU_TEXT_URL=https://api.z.ai/api/paas/v4/chat/completions
# ZHIPU_TEXT_MODEL=glm-4.7-flash
# ZHIPU_VISION_URL=https://api.z.ai/api/paas/v4/chat/completions
# ZHIPU_VISION_MODEL=glm-4.6v-flash
# Отключить reasoning-режим (иначе ответ прячется в reasoning_content и уходит в дефолт)
# ZHIPU_THINKING_DISABLED=true
# ZHIPU_MAX_TOKENS=160
# Адаптивный backoff при сбоях/429: база ZHIPU_COOLDOWN_MS (умножается ×2 за каждый подряд
# сбой, кап ZHIPU_COOLDOWN_MAX_MS). После успеха сбрасывается в ноль — «стенки» на 60с нет.
# ZHIPU_COOLDOWN_MS=1000
# ZHIPU_COOLDOWN_MAX_MS=15000
# Пауза при неверном ключе (401/403), мс
# ZHIPU_AUTH_COOLDOWN_MS=60000
